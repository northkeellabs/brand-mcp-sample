{
  "font": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": [
          "Arial Narrow",
          "Helvetica Neue",
          "sans-serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Segoe UI",
          "Helvetica",
          "sans-serif"
        ]
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": {
          "value": 13,
          "unit": "px"
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 15,
          "unit": "px"
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 19,
          "unit": "px"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "xxl": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        }
      }
    }
  },
  "type": {
    "$type": "typography",
    "heading": {
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "{font.size.xxl}",
        "fontWeight": 800,
        "lineHeight": 1.15
      }
    },
    "subheading": {
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "{font.size.lg}",
        "fontWeight": 800,
        "lineHeight": 1.25
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "{font.size.md}",
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "{font.size.xs}",
        "fontWeight": 400,
        "lineHeight": 1.4
      }
    }
  }
}
